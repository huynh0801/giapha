# -----------------------------------------------------------------------------
# GIA PHẢ DÒNG HỌ - MẪU BIẾN MÔI TRƯỜNG CẤU HÌNH (ENVIRONMENT VARIABLES)
# -----------------------------------------------------------------------------
# Hướng dẫn:
# 1. Chép (copy) file này thành ".env.local"
# 2. Điền các giá trị thực tế tương ứng với dự án Supabase của bạn

# Tên của ứng dụng web được hiển thị cho người dùng
SITE_NAME="GIA PHẢ DÒNG HỌ"

# Server-Only Supabase Configuration (Khuyên dùng - Không bị lộ ra trình duyệt)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-or-public-key"
# Bắt buộc trên Vercel để cào tin tức tự động và server admin bypass RLS:
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Vercel Cron Secret (Bắt buộc để Vercel Cron tự động cào tin mỗi ngày):
CRON_SECRET="your-random-cron-secret-token"

# Legacy / Client fallback (Tương thích ngược)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY="your-anon-or-public-key"

# Cloudflare R2 Storage (Tùy chọn - Tối ưu chi phí & Miễn phí băng thông tải ảnh)
CLOUDFLARE_R2_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CLOUDFLARE_R2_BUCKET_NAME="giaphadongho"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-xxxxxx.r2.dev"
