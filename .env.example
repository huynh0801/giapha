# -----------------------------------------------------------------------------
# GIA PHẢ DÒNG HỌ - MẪU BIẾN MÔI TRƯỜNG CẤU HÌNH (ENVIRONMENT VARIABLES)
# -----------------------------------------------------------------------------
# Hướng dẫn:
# 1. Chép (copy) file này thành ".env.local"
# 2. Điền các giá trị thực tế tương ứng với dự án Supabase của bạn

# Tên của ứng dụng web được hiển thị cho người dùng
SITE_NAME="GIA PHẢ DÒNG HỌ"

# Server-Only Supabase Configuration (Khuyên dùng - Không bị lộ ra trình duyệt)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-or-public-key"

# Legacy / Client fallback (Tương thích ngược)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY="your-anon-or-public-key"
